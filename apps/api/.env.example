# Port the Express API listens on.
PORT=3000

# AWS region (any value works for DynamoDB Local).
AWS_REGION=ap-northeast-1

# DynamoDB endpoint.
# For local development, point at DynamoDB Local (docker-compose) below.
# For real AWS, LEAVE THIS UNSET so the SDK talks to the real DynamoDB service.
DYNAMODB_ENDPOINT=http://localhost:8000

# Table names (defaults shown).
POLICIES_TABLE=mailguard-policies
AUDIT_TABLE=mailguard-audit

# Dummy credentials for DynamoDB Local (it ignores the values but the SDK
# requires SOMETHING to be set). For real AWS, use real credentials / an IAM role.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
