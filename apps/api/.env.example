# Port the Express API listens on.
PORT=3000

# AWS region (any value works for DynamoDB Local).
AWS_REGION=ap-northeast-1

# DynamoDB endpoint.
# For local development, point at DynamoDB Local (docker-compose) below.
# For real AWS, LEAVE THIS UNSET so the SDK talks to the real DynamoDB service.
DYNAMODB_ENDPOINT=http://localhost:8000

# Table names (defaults shown).
POLICIES_TABLE=mailguard-policies
AUDIT_TABLE=mailguard-audit

# NOTE: no AWS credentials here on purpose.
# - Local: the code injects throwaway credentials automatically whenever
#   DYNAMODB_ENDPOINT is set (see src/db/client.ts), so DynamoDB Local just works.
# - Real AWS: leave DYNAMODB_ENDPOINT unset and the SDK uses your normal
#   credentials (aws configure) locally, or the Lambda's IAM role in production.
# Putting dummy AWS_ACCESS_KEY_ID=local here would override real credentials and
# break any command that talks to real AWS from your machine.
