{
  "name": "@mailguard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx src/setup/create-tables.ts",
    "db:seed": "tsx src/setup/seed.ts",
    "db:reset": "tsx src/setup/create-tables.ts && tsx src/setup/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.716.0",
    "@aws-sdk/lib-dynamodb": "3.716.0",
    "@mailguard/dlp-engine": "workspace:*",
    "@mailguard/schemas": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
